# ==============================================================================
# Polydispute Deployment Environment Configuration (.env)
# ==============================================================================

# Target stage: "prod" or "dev"
PIPELINE_ENV=prod

# MotherDuck Cloud Data Warehouse Token (REQUIRED if DOPPLER_TOKEN is not used)
MOTHERDUCK_TOKEN=ey...

# Target Database in MotherDuck (defaults to polydispute_prod if unset)
MOTHERDUCK_DATABASE=polydispute_prod

# Doppler Secrets Management (Alternative to manual env vars above)
DOPPLER_TOKEN=
DOPPLER_PROJECT=polydispute
DOPPLER_CONFIG=prd

# Ingestion Tokens (Optional for read-only dashboard, required for pipeline worker)
DISCORD_AUTH_TOKEN=
POLYGONSCAN_API_KEY=

# Server Configuration
HOST=0.0.0.0
