# .env.example
# NEVER COMMIT REAL SECRETS. Copy this file to .env.<label> for local development.

# External APIs
ETHERSCAN_API_KEY="placeholder_etherscan_key_here"
POLYGONSCAN_API_KEY="placeholder_polygonscan_key_here"

# LLM Providers
OPENAI_API_KEY="sk-placeholder"
ANTHROPIC_API_KEY="sk-ant-placeholder"

# RPC Nodes
ETHEREUM_RPC_URL="https://ethereum-rpc.publicnode.com"
POLYGON_RPC_URL="https://polygon-rpc.com"

# Storage Backup (Cloudflare R2)
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>/<PREFIX>"
# Used for curl/bash scripts:
R2_API_TOKEN="cfut_placeholder"
# Used for Python SDKs (boto3, awswrangler):
AWS_ACCESS_KEY_ID="placeholder_access_key"
AWS_SECRET_ACCESS_KEY="placeholder_secret_key"

# Observability
SENTRY_DSN=""
