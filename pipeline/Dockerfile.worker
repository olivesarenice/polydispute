FROM python:3.12-slim

WORKDIR /app

# Target Doppler Project & Config for this worker image
ENV DOPPLER_PROJECT=polydispute
ENV DOPPLER_CONFIG=dev

# Enable bytecode compilation for performance
ENV UV_COMPILE_BYTECODE=1

# 1. Install Doppler CLI with apt cache mounting
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends curl gnupg && \
    curl -sLf --retry 3 https://packages.doppler.com/public/cli/gpg.45887C70B10F3642.key | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" | tee /etc/apt/sources.list.d/doppler-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends doppler

# 2. Copy the uv binary directly from the official astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 3. Copy pyproject.toml & uv.lock first to leverage Docker layer caching
COPY pyproject.toml uv.lock ./

# 4. Install dependencies using BuildKit uv cache mount for lightning-fast builds
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# 5. Copy application source code (frequently changing layer)
COPY src ./src

# Create the data directory for the pipeline to use
RUN mkdir -p data

# Use ENTRYPOINT to automatically wrap all container commands with Doppler
ENTRYPOINT ["doppler", "run", "--"]

# CMD preserves pure uv run syntax
CMD ["uv", "run", "prefect", "worker", "start", "--pool", "polydispute-pool"]
